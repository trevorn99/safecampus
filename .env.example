# Copy to .env.local (git-ignored) and fill in per environment.
# Prod values live in Vercel/GitHub project settings, never in a committed file.

# Supabase — project settings > API
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# service_role key — server-only, never prefix with NEXT_PUBLIC_
SUPABASE_SERVICE_ROLE_KEY=

# Planning Center — no env vars: each org registers and manages its own
# OAuth app's client ID/secret from /schedule/planning-center, stored in
# pco_app_credentials, not here.

# SendGrid
SENDGRID_API_KEY=

# Twilio — one shared platform-wide account (like SendGrid above), used for
# SMS shift reminders. TWILIO_FROM_NUMBER must be an SMS-capable number (or
# Messaging Service SID) on that same account.
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM_NUMBER=

# Stripe — separate test-mode (dev) and live-mode (prod) API keys/products
STRIPE_SECRET_KEY=
# Flat-rate plan Prices: up to 10 / 30 / 50 active members
STRIPE_TIER_10_PRICE_ID=
STRIPE_TIER_30_PRICE_ID=
STRIPE_TIER_50_PRICE_ID=
# Webhook signing secret from the endpoint registered for this environment
STRIPE_WEBHOOK_SECRET=

# Authenticates Vercel Cron's daily call to /api/cron/generate-events —
# Vercel sends this automatically as a bearer token once the var is set.
# Note: Vercel Cron only fires against the Production deployment, so this
# has no effect until the schedule migration + this env var are on main.
CRON_SECRET=
