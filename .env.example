# Copy to .env.local (git-ignored) and fill in per environment.
# Prod values live in Vercel/GitHub project settings, never in a committed file.

# Supabase — project settings > API
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# service_role key — server-only, never prefix with NEXT_PUBLIC_
SUPABASE_SERVICE_ROLE_KEY=

# Planning Center — no env vars: each org registers and manages its own
# OAuth app's client ID/secret from /schedule/planning-center, stored in
# pco_app_credentials, not here.

# SendGrid
SENDGRID_API_KEY=

# SignalWire — one shared platform-wide account (like SendGrid above), used
# for SMS shift reminders via its Twilio-compatible Compatibility API.
# SIGNALWIRE_SPACE_URL is your Space's full domain (e.g. your-space.signalwire.com,
# no https://). SIGNALWIRE_FROM_NUMBER must be an SMS-capable number on that
# same Space.
SIGNALWIRE_SPACE_URL=
SIGNALWIRE_PROJECT_ID=
SIGNALWIRE_API_TOKEN=
SIGNALWIRE_FROM_NUMBER=
# Signing key for verifying inbound webhook requests (STOP/HELP replies —
# see /api/sms/webhook). From the SignalWire dashboard's API Credentials
# page — check whether it's the same value as SIGNALWIRE_API_TOKEN or a
# separate signing-specific key for your account.
SIGNALWIRE_SIGNING_KEY=

# Stripe — separate test-mode (dev) and live-mode (prod) API keys/products
STRIPE_SECRET_KEY=
# Flat-rate plan Prices: up to 10 / 30 / 50 active members
STRIPE_TIER_10_PRICE_ID=
STRIPE_TIER_30_PRICE_ID=
STRIPE_TIER_50_PRICE_ID=
# Threat Intelligence add-on: $30/mo, added as a second item on an org's
# existing subscription (see /api/billing/toggle-addon).
STRIPE_THREAT_INTEL_PRICE_ID=
# Webhook signing secret from the endpoint registered for this environment
STRIPE_WEBHOOK_SECRET=

# Authenticates Vercel Cron's daily/weekly calls to /api/cron/* — Vercel
# sends this automatically as a bearer token once the var is set.
# Note: Vercel Cron only fires against the Production deployment, so this
# has no effect until the schedule migration + this env var are on main.
CRON_SECRET=

# Anthropic — used to draft Threat Intelligence reports (paid add-on).
ANTHROPIC_API_KEY=
